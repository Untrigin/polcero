# Copy to ".env" and fill in the secrets. Do NOT commit ".env" (it is gitignored).
# On the server, either load this file (node --env-file=.env ...) or set these
# in the process environment (systemd / pm2 / docker).

# Outgoing mail (SMTP) - seohost.pl example:
SMTP_HOST=h51.seohost.pl
SMTP_PORT=465
SMTP_SECURE=true            # true for port 465 (SSL/TLS), false for 587 (STARTTLS)
SMTP_USER=biuro@polcero.com # full mailbox address = the login
SMTP_PASS=                  # the mailbox password (secret)

# Where contact-form enquiries are delivered, and the From address:
MAIL_TO=biuro@polcero.com
MAIL_FROM="POLCERO <biuro@polcero.com>"
