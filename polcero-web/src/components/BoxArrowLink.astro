---
import { ArrowRight } from '@lucide/astro';

interface Props {
  href: string;
  label?: string;
  variant?: 'light' | 'dark' | 'accent';
  ariaLabel?: string;
  class?: string;
}

const { href, label, variant = 'dark', ariaLabel, class: className = '' } = Astro.props;
if (!label && !ariaLabel) {
  throw new Error('BoxArrowLink: provide `label` or `ariaLabel`.');
}
const isPill = variant === 'accent';
---
<a
  href={href}
  aria-label={!label ? ariaLabel : undefined}
  class:list={[
    'arrow-cta',
    isPill ? ['btn-pill', 'btn-accent'] : ['arrow-link', `arrow-link--${variant}`],
    className,
  ]}
>
  {label && <span>{label}</span>}
  <ArrowRight size={18} aria-hidden="true" />
</a>

<style>
  .arrow-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
  }
  /* lucide renders its own <svg> (a component), so scoped selectors need :global */
  .arrow-cta :global(svg) {
    flex: 0 0 auto;
    transition: transform 0.22s var(--ease-out);
  }
  .arrow-cta:hover :global(svg) { transform: translateX(4px); }

  .arrow-link {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1;
  }
  .arrow-link--dark { color: var(--color-ice); }
  .arrow-link--dark:hover { color: var(--color-accent); }
  .arrow-link--light { color: var(--color-panel-ink); }
  .arrow-link--light:hover { color: var(--color-accent); }
  .arrow-link--dark :global(svg),
  .arrow-link--light :global(svg) { color: var(--color-accent); }
</style>
