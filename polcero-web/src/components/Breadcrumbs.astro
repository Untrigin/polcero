---
import JsonLd from './JsonLd.astro';

export interface Crumb { label: string; href: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const site = Astro.site ?? new URL('https://polcero.com');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, site).href,
  })),
};
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={c.href}>{c.label}</a>
        ) : (
          <span aria-current="page">{c.label}</span>
        )}
        {i < items.length - 1 && <span class="crumbs__sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
<JsonLd schema={jsonLd} />

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-mute);
  }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .crumbs a { color: var(--color-mute); transition: color 0.18s var(--ease-out); }
  .crumbs a:hover { color: var(--color-accent); }
  .crumbs [aria-current='page'] { color: var(--color-ice); }
  .crumbs__sep { opacity: 0.5; }
</style>
