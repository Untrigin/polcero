---
import type { Locale } from '../lib/i18n';
import { localizedPath } from '../lib/i18n';
import { getContent } from '../data/content';
import { getUI } from '../data/ui';
import SplitHeading from './SplitHeading.astro';
import BoxArrowLink from './BoxArrowLink.astro';
import MediaFrame from './MediaFrame.astro';
import { ArrowUpRight } from '@lucide/astro';
import Reveal from './Reveal.astro';
import ProductCard from './ProductCard.astro';
import TabsShowcase from './TabsShowcase.astro';
import ProductHoverList from './ProductHoverList.astro';
import BranchGrid from './BranchGrid.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const p = (path: string) => localizedPath(path, locale);
const t = getUI(locale).home;
const cardProducts = c.products.slice(0, 4);
const orderLabel = t.order;
---

{/* ── 01 HERO - full-screen looping video (mobile = image) ── */}
<section class="hero-full">
  <div class="hero-full__bg">
    <img class="hero-full__img" src="/media/hero-mobile.webp" alt={c.hero.imageAlt} width="1080" height="1440" fetchpriority="high" decoding="async" />
    <img class="hero-full__anim" data-hero-bg data-src="/media/hero-bg.webp" data-poster="/media/hero-bg-poster.jpg" alt="" width="1000" height="562" decoding="async" aria-hidden="true" />
    <span class="hero-full__scrim" aria-hidden="true"></span>
  </div>
  <div class="hero-full__content container-x">
    <p class="eyebrow">{c.hero.eyebrow}</p>
    <SplitHeading parts={c.hero.h1} as="h1" class="hero-full__h1" />
    <p class="hero-full__subhead">{c.hero.subhead}</p>
    <div class="hero-full__cta">
      <a class="btn-pill btn-accent" href={p('/contact/')}>{c.hero.ctaPrimary}</a>
      <a class="btn-pill btn-glass" href={p('/products/polcero-os/')}>{c.hero.ctaSecondary} <ArrowUpRight size={18} aria-hidden="true" /></a>
    </div>
  </div>
  <a class="hero-full__scroll" href="#ekosystem" aria-label={t.scrollDown}>
    <span class="hero-full__scroll-dot"></span>
  </a>
</section>

{/* ── 02 ECOSYSTEM statement ──────────────────────────────── */}
<section class="section ecosystem" id="ekosystem">
  <div class="container-x">
    <div class="hero__lead-row">
      <Reveal><SplitHeading parts={c.hero.h2} as="h2" /></Reveal>
      <Reveal delay={80} class="hero__lead-col">
        <p class="lead">{c.hero.body}</p>
        <BoxArrowLink href={p('/products/polcero-os/')} label={c.hero.ctaSecondary} variant="dark" />
      </Reveal>
    </div>

    <Reveal delay={120} class="ecosystem__media">
      <MediaFrame
        src="/media/ecosystem.webp"
        alt={t.ecosystemAlt}
        width={1400}
        height={611}
        parallax
        sizes="(min-width: 1280px) 1216px, 100vw"
      />
    </Reveal>
  </div>
</section>

{/* ── STATS STRIP (real figures from the brief) ───────────── */}
<section class="stats-strip">
  <div class="container-x">
    <dl class="stats-strip__grid">
      {c.stats.map((s, i) => (
        <Reveal as="div" delay={i * 60} class="stats-strip__item">
          <dt class="stats-strip__value">{s.value}</dt>
          <dd class="stats-strip__label">{s.label}</dd>
        </Reveal>
      ))}
    </dl>
  </div>
</section>

{/* ── 03 PLATFORM / ECOSYSTEM ─────────────────────────────── */}
<section class="section platform">
  <div class="container-x">
    <div class="platform__head">
      <Reveal>
        <p class="platform__wordmark">{c.platform.wordmark}</p>
        <SplitHeading parts={c.platform.h2} as="h2" class="platform__h2" />
      </Reveal>
      <Reveal delay={80} class="platform__intro">
        <p class="lead">{c.platform.body}</p>
        <BoxArrowLink href={p('/products/polcero-os/')} label={c.platform.cta} variant="dark" />
      </Reveal>
    </div>
    <div class="platform__layers">
      {c.platform.layers.map((l, i) => (
        <Reveal delay={i * 70} class="platform__layer">
          <span class="platform__layer-num label-mono">{l.label}</span>
          <h3 class="platform__layer-title">{l.title}</h3>
          <p class="platform__layer-body">{l.body}</p>
        </Reveal>
      ))}
    </div>
  </div>
</section>

{/* ── 04 TABS - "Gdzie pracuje" ───────────────────────────── */}
<section class="section tabs-section">
  <div class="container-x">
    <Reveal class="tabs-section__head">
      <p class="eyebrow">{t.applications}</p>
      <SplitHeading parts={c.tabs.h2} as="h2" />
    </Reveal>
    <Reveal delay={80}>
      <TabsShowcase items={c.tabs.items} />
    </Reveal>
  </div>
</section>

{/* ── 05 PRODUCT OVERVIEW (hover list) ────────────────────── */}
<section class="section overview">
  <div class="container-x">
    <Reveal class="overview__head">
      <SplitHeading parts={c.overview.h2} as="h2" />
      <p class="lead">{c.overview.lead}</p>
    </Reveal>
    <Reveal delay={80}>
      <ProductHoverList products={c.products} locale={locale} />
    </Reveal>
  </div>
</section>

{/* ── ENERGY - self-swapping batteries + charging station ── */}
<section class="section energy">
  <div class="container-x energy__grid">
    <Reveal class="energy__body">
      <p class="eyebrow">{t.energy.eyebrow}</p>
      <h2 class="h2 energy__title">{t.energy.title}</h2>
      <p class="lead">{t.energy.lead}</p>
      <dl class="energy__points">
        {t.energy.points.map((pt) => (
          <div><dt>{pt.title}</dt><dd>{pt.text}</dd></div>
        ))}
      </dl>
    </Reveal>
    <Reveal delay={80} class="energy__media">
      <span class="energy__tile"><img src="/media/battery-status.webp" alt={t.energy.alt} width="960" height="640" loading="lazy" decoding="async" /></span>
    </Reveal>
  </div>
</section>

{/* ── POWER INFRASTRUCTURE - batteries or grid ───────────── */}
<section class="section grid-power">
  <div class="container-x">
    <Reveal class="grid-power__head">
      <p class="eyebrow">{t.grid.eyebrow}</p>
      <h2 class="h2">{t.grid.title}</h2>
      <p class="lead grid-power__lead">{t.grid.lead}</p>
    </Reveal>
    <div class="grid-power__grid">
      {t.grid.modes.map((m, i) => (
        <Reveal delay={i * 60}>
          <div class="grid-power__mode">
            <span class="grid-power__num label-mono">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="grid-power__name">{m.name}</h3>
            <p class="grid-power__text">{m.text}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>

{/* ── 06 PRODUCT CARDS - "Available to order" ─────────────── */}
<section class="section cards">
  <div class="container-x">
    <Reveal class="cards__head">
      <p class="eyebrow">{c.cards.eyebrow}</p>
      <SplitHeading parts={c.cards.h2} as="h2" />
    </Reveal>
    <div class="cards__grid">
      {cardProducts.map((product, i) => (
        <Reveal delay={i * 60}>
          <ProductCard product={product} locale={locale} ctaLabel={orderLabel} />
        </Reveal>
      ))}
    </div>
  </div>
</section>

{/* ── BUSINESS BRANCHES (transferred from polcero-web) ────── */}
<section class="section branches-section">
  <div class="container-x">
    <div class="branches-section__head">
      <Reveal>
        <p class="eyebrow">{c.services.eyebrow}</p>
        <SplitHeading parts={c.services.h2} as="h2" />
      </Reveal>
      <Reveal delay={80} class="branches-section__intro">
        <p class="lead">{c.services.lead}</p>
        <BoxArrowLink href={p('/services/')} label={c.services.all} variant="dark" />
      </Reveal>
    </div>
    <BranchGrid branches={c.branches} locale={locale} showDesc={false} />
  </div>
</section>

{/* ── 07 MISSION ──────────────────────────────────────────── */}
<section class="mission">
  <video
    class="mission__bg"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/media/warehouse-walk-poster.jpg"
    aria-label={t.missionAlt}
  >
    <source src="/media/warehouse-walk.mp4" type="video/mp4" />
  </video>
  <div class="mission__overlay"></div>
  <div class="container-x mission__inner">
    <Reveal>
      <SplitHeading parts={c.mission.h2} as="h2" class="mission__h2" />
      <p class="mission__body">{c.mission.body}</p>
    </Reveal>
  </div>
</section>

{/* ── 08 CLOSING CTA ──────────────────────────────────────── */}
<section class="section closing">
  <div class="container-x closing__inner">
    <Reveal>
      <SplitHeading parts={c.closing.h2} as="h2" class="closing__h2" />
      <p class="lead closing__body">{c.closing.body}</p>
      <BoxArrowLink href={p('/contact/')} label={c.closing.cta} variant="accent" class="closing__cta" />
    </Reveal>
  </div>
</section>

<style>
  /* ── FULL-SCREEN HERO ── */
  .hero-full {
    position: relative;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-h)); /* sit under the transparent sticky header */
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-full__bg { position: absolute; inset: 0; z-index: -1; background: var(--color-void); }
  .hero-full__img,
  .hero-full__anim {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .hero-full__anim { opacity: 0; transition: opacity 0.9s var(--ease-out); }
  .hero-full__anim.is-playing { opacity: 1; }
  .hero-full__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(10,10,11,0.9) 0%, rgba(10,10,11,0.55) 42%, rgba(10,10,11,0.15) 100%),
      linear-gradient(0deg, rgba(10,10,11,0.85) 0%, transparent 40%);
  }
  .hero-full__content {
    position: relative;
    padding-top: var(--header-h);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    max-width: 62rem;
  }
  .hero-full__h1 { margin-top: 1.5rem; }
  .hero-full__subhead {
    margin-top: 1.75rem;
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    color: var(--color-ice);
    max-width: 46ch;
    line-height: 1.45;
  }
  .hero-full__cta { margin-top: 2.75rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .hero-full__scroll {
    position: absolute;
    bottom: 1.75rem; left: 50%;
    width: 26px; height: 42px;
    transform: translateX(-50%);
    border: 1px solid var(--color-mute);
    border-radius: 999px;
    display: grid; place-items: start center;
    padding-top: 7px;
  }
  .hero-full__scroll-dot { width: 4px; height: 8px; border-radius: 999px; background: var(--color-accent); animation: heroScroll 1.8s var(--ease-out) infinite; }
  @keyframes heroScroll { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }

  /* ── ECOSYSTEM (was the hero lead-row) ── */
  .ecosystem { padding-top: clamp(4.5rem, 9vw, 8rem); }
  .ecosystem :global(.ecosystem__media) { margin-top: clamp(3.5rem, 7vw, 6rem); }
  .hero__lead-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .hero__lead-row :global(.hero__lead-col) { display: flex; flex-direction: column; gap: 2.25rem; }
  .hero__cta { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }

  @media (min-width: 768px) { .hero-full__img { display: none; } }
  @media (max-width: 767px) {
    /* Mobile keeps the still as an instant poster; the looping hero fades in over it. */
    .hero-full__anim { display: block; }
    .hero-full__scrim { background:
      linear-gradient(0deg, rgba(10,10,11,0.92) 0%, rgba(10,10,11,0.35) 55%, rgba(10,10,11,0.15) 100%); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-full__scroll-dot { animation: none; } }

  /* STATS STRIP */
  .stats-strip { border-top: 1px solid var(--color-line); }
  .stats-strip__grid { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; }
  .stats-strip__grid :global(.stats-strip__item) { padding: clamp(2rem, 4vw, 3.25rem) clamp(1rem, 2vw, 2rem); border-right: 1px solid var(--color-line); }
  .stats-strip__grid :global(.stats-strip__item):last-child { border-right: 0; }
  .stats-strip__value { font-family: var(--font-display); font-weight: 300; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1; letter-spacing: -0.02em; color: var(--color-ice); }
  .stats-strip__label { margin: 0.75rem 0 0; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-mute); line-height: 1.4; }

  /* PLATFORM */
  .platform { background: var(--color-surface); border-block: 1px solid var(--color-line); position: relative; overflow: hidden; }
  .platform::before {
    content: '';
    position: absolute;
    inset: -30% 40% auto -10%;
    height: 120%;
    background: radial-gradient(50% 50% at 50% 50%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 70%);
    pointer-events: none;
  }
  .platform__head {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }
  .platform__wordmark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .platform__head :global(.platform__intro) { display: flex; flex-direction: column; gap: 1.75rem; }
  .platform__layers {
    position: relative;
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .platform__layers :global(.platform__layer) { padding-top: 1.75rem; border-top: 1px solid var(--color-line); }
  .platform__layer-num { color: var(--color-accent); }
  .platform__layer-title { font-family: var(--font-display); font-weight: 500; font-size: 1.35rem; margin: 0.75rem 0 0.6rem; }
  .platform__layer-body { color: var(--color-mute); font-size: 0.98rem; line-height: 1.6; }

  /* BRANCHES (void bg so cards pop; keeps light/dark rhythm vs the surface cards above) */
  .branches-section { border-top: 1px solid var(--color-line); }
  .branches-section__head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .branches-section__head .eyebrow { margin-bottom: 1rem; }
  .branches-section__head :global(.branches-section__intro) { display: flex; flex-direction: column; gap: 1.75rem; }

  /* Section heads */
  .tabs-section :global(.tabs-section__head), .cards :global(.cards__head) { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .tabs-section :global(.tabs-section__head) .eyebrow, .cards :global(.cards__head) .eyebrow { margin-bottom: 1rem; }
  .overview :global(.overview__head) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ENERGY (battery status + charging station) */
  .energy { border-top: 1px solid var(--color-line); }
  .energy__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .energy__grid :global(.energy__body) { display: flex; flex-direction: column; gap: 1.1rem; }
  .energy__body .eyebrow { margin-bottom: 0.25rem; }
  .energy__points { margin: 0.25rem 0 0; display: grid; gap: 0; }
  .energy__points > div { padding: 0.85rem 0; border-top: 1px solid var(--color-line); }
  .energy__points dt { font-family: var(--font-display); font-weight: 500; font-size: 1.05rem; color: var(--color-ice); }
  .energy__points dd { margin: 0.25rem 0 0; color: var(--color-mute); line-height: 1.55; }
  .energy__grid :global(.energy__media) { display: block; }
  .energy__tile { display: block; border-radius: var(--radius-card); background: var(--color-panel); border: 1px solid var(--color-line); overflow: hidden; }
  .energy__tile img { width: 100%; height: auto; display: block; }

  /* POWER INFRASTRUCTURE */
  .grid-power { border-top: 1px solid var(--color-line); }
  .grid-power__head { max-width: 60rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .grid-power__head .eyebrow { margin-bottom: 1rem; }
  .grid-power__lead { color: var(--color-mute); margin-top: 1rem; }
  .grid-power__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 2.5vw, 2rem); }
  .grid-power__mode { padding: clamp(1.25rem, 2vw, 1.75rem); border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); height: 100%; }
  .grid-power__num { color: var(--color-accent); }
  .grid-power__name { font-family: var(--font-display); font-weight: 500; font-size: 1.25rem; color: var(--color-ice); margin: 0.6rem 0; }
  .grid-power__text { color: var(--color-mute); line-height: 1.6; }
  @media (max-width: 900px) { .energy__grid { grid-template-columns: 1fr; } .grid-power__grid { grid-template-columns: 1fr; } }

  /* CARDS */
  .cards { background: var(--color-surface); border-block: 1px solid var(--color-line); }
  .cards__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 2.5vw, 2.25rem); }

  /* MISSION */
  .mission { position: relative; min-height: 70vh; display: grid; align-items: center; overflow: hidden; }
  .mission__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mission__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,11,0.7), rgba(10,10,11,0.82)); }
  .mission__inner { position: relative; text-align: center; padding-block: clamp(5rem, 10vw, 9rem); }
  .mission__inner :global(.mission__h2) { margin-inline: auto; max-width: 18ch; color: #F4F5F7; }
  .mission__body { margin: 1.75rem auto 0; max-width: 56ch; color: #F4F5F7; font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.6; }

  /* CLOSING */
  .closing__inner { text-align: center; max-width: 44rem; margin-inline: auto; }
  .closing__body { margin: 1.75rem auto 2.5rem; }
  .closing__cta { justify-content: center; }
  .closing__h2 span { }

  /* Responsive */
  @media (max-width: 900px) {
    .hero__lead-row, .platform__head, .platform__layers, .branches-section__head { grid-template-columns: 1fr; }
    .overview :global(.overview__head) { grid-template-columns: 1fr; }
    .cards__grid { grid-template-columns: repeat(2, 1fr); }
    .platform__layers { gap: 0; }
    .platform__layers :global(.platform__layer) { border-top: 1px solid var(--color-line); }
    .stats-strip__grid { grid-template-columns: repeat(2, 1fr); }
    .stats-strip__grid :global(.stats-strip__item):nth-child(2) { border-right: 0; }
    .stats-strip__grid :global(.stats-strip__item):nth-child(-n+2) { border-bottom: 1px solid var(--color-line); }
  }
  @media (max-width: 540px) {
    .cards__grid { grid-template-columns: 1fr; }
    .hero__cta { gap: 1rem; }
  }
</style>
