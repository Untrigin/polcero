---
import BoxArrowLink from './BoxArrowLink.astro';
import type { Product } from '../data/content';
import { localizedPath, type Locale } from '../lib/i18n';

interface Props {
  product: Product;
  locale: Locale;
  ctaLabel: string;
}
const { product, locale, ctaLabel } = Astro.props;
const href = localizedPath(`/products/${product.slug}/`, locale);
---
<article class="product-card">
  <a href={href} class="product-card__media" aria-hidden="true" tabindex="-1">
    <img src={product.image} alt="" width="512" height="512" loading="lazy" decoding="async" />
  </a>
  <div class="product-card__body">
    <p class="label-mono">{product.category}</p>
    <h3 class="product-card__name">
      <a href={href}>{product.name}</a>
    </h3>
    {product.subtitle && <p class="product-card__subtitle">{product.subtitle}</p>}
    <p class="product-card__blurb">{product.blurb}</p>
    <div class="product-card__foot">
      {product.price && <span class="product-card__price">{product.price}</span>}
      <BoxArrowLink href={href} label={ctaLabel} variant="dark" class="product-card__cta" />
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .product-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out);
  }
  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card:hover .product-card__media { transform: translateY(-4px); }
  .product-card__body { display: flex; flex-direction: column; gap: 0.6rem; }
  .product-card__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .product-card__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .product-card__name { position: relative; }
  .product-card__subtitle {
    color: var(--color-accent);
    font-size: 0.92rem;
    font-weight: 500;
    margin-top: -0.15rem;
  }
  .product-card__blurb {
    color: var(--color-mute);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .product-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.35rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
  }
  .product-card__price { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; color: var(--color-ice); }
  .product-card__cta { position: relative; z-index: 1; }

  @media (prefers-reduced-motion: reduce) {
    .product-card:hover .product-card__media { transform: none; }
  }
</style>
