---
import type { SiteContent } from '../data/content';
import { localizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  content: SiteContent;
}
const { locale, content } = Astro.props;
const year = 2026;
const homeHref = localizedPath('/', locale);
// Footer column hrefs are stored unprefixed; localize internal page paths only
// (skip files like /rss.xml or the About PDF, and any external/anchor links).
const locHref = (href: string) =>
  href.startsWith('/') && !href.startsWith('//') && !href.includes('.') ? localizedPath(href, locale) : href;
---
<footer class="site-footer">
  <div class="container-x">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={homeHref} class="site-footer__logo" aria-label="POLCERO">
          <img src="/polcero_white.svg" alt="POLCERO" width="367" height="70" />
        </a>
        <p class="site-footer__tagline">{content.footer.tagline}</p>
        <ul class="site-footer__contact">
          <li><a href="mailto:biuro@polcero.com">biuro@polcero.com</a></li>
          <li><a href="tel:+48535777268">+48 535 777 268</a></li>
        </ul>
        <div class="site-footer__social">
          <a href="https://www.linkedin.com/company/polskiecentrumrobotyzacji" aria-label="LinkedIn" rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C20.4 8.65 22 10.6 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21H9V9Z"/></svg>
          </a>
          <a href="https://www.facebook.com/PolskieCentrumRobotyzacji" aria-label="Facebook" rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
          </a>
        </div>
      </div>

      <nav class="site-footer__cols" aria-label={locale === 'pl' ? 'Stopka' : 'Footer'}>
        {content.footer.columns.map((col) => (
          <div class="site-footer__col">
            <h2 class="site-footer__col-title">{col.title}</h2>
            <ul>
              {col.links.map((link) => (
                <li><a href={locHref(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <hr class="hairline" />

    <div class="site-footer__legal">
      <p>© {year} POLCERO sp. z o.o. · KRS 0001178417 · NIP 8971955510. {content.footer.rights}</p>
      <div class="site-footer__legal-links">
        <a href={localizedPath('/privacy/', locale)}>{content.footer.legal}</a>
        <a href={localizedPath('/cookies/', locale)}>{locale === 'pl' ? 'Polityka cookie' : 'Cookie Policy'}</a>
        <a href={localizedPath('/terms/', locale)}>{locale === 'pl' ? 'Regulamin' : 'Terms'}</a>
        <button type="button" class="site-footer__cookie-btn" data-cookie-settings>{locale === 'pl' ? 'Ustawienia cookie' : 'Cookie settings'}</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    padding-block: clamp(3.5rem, 7vw, 6rem) 2.5rem;
    margin-top: 0;
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 2.6fr;
    gap: clamp(2.5rem, 5vw, 5rem);
  }
  .site-footer__logo img { height: 30px; width: auto; display: block; }
  .site-footer__contact { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .site-footer__contact a { color: var(--color-ice); font-size: 0.95rem; }
  .site-footer__contact a:hover { color: var(--color-accent); }
  .site-footer__tagline {
    margin-top: 1rem;
    color: var(--color-mute);
    max-width: 34ch;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .site-footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--color-line);
    color: var(--color-mute);
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  .site-footer__social a:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .site-footer__col-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 1rem;
  }
  .site-footer__col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .site-footer__col a {
    color: var(--color-ice);
    font-size: 0.95rem;
    transition: color 0.18s var(--ease-out);
  }
  .site-footer__col a:hover { color: var(--color-accent); }
  .site-footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    color: var(--color-mute);
    font-size: 0.85rem;
  }
  .site-footer__legal-links { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; }
  .site-footer__legal-links a:hover { color: var(--color-accent); }
  .site-footer__cookie-btn { background: none; border: none; padding: 0; cursor: pointer; color: var(--color-mute); font: inherit; font-size: 0.85rem; }
  .site-footer__cookie-btn:hover { color: var(--color-accent); }

  @media (max-width: 900px) {
    .site-footer__top { grid-template-columns: 1fr; }
    .site-footer__cols { grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; }
  }
  @media (max-width: 480px) {
    .site-footer__cols { grid-template-columns: 1fr; }
  }
</style>
