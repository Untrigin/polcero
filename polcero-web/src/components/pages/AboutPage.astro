---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import MediaFrame from '../MediaFrame.astro';
import BoxArrowLink from '../BoxArrowLink.astro';
import Reveal from '../Reveal.astro';
import { getUI } from '../../data/ui';
import { localizedPath, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const p = (path: string) => localizedPath(path, locale);
const t = getUI(locale).aboutPage;
const crumbs = [
  { label: t.home, href: p('/') },
  { label: t.about, href: p('/about/') },
];
---
<Layout title={`${t.about} - POLCERO`} description={t.lead.slice(0, 154)} canonicalPath={p('/about/')}>
  <PageHeader eyebrow="POLCERO" title={t.title} lead={t.lead} crumbs={crumbs} />
  <section class="section">
    <div class="container-x">
      <Reveal><MediaFrame src="/media/mission.webp" alt={t.imageAlt} width={2000} height={1200} parallax /></Reveal>
      <Reveal delay={80} class="about-pdf">
        <a class="btn-pill btn-glass" href="/POLCERO-About-us.pdf" target="_blank" rel="noopener">{t.pdf}</a>
      </Reveal>
    </div>
  </section>
  <section class="section about-blocks">
    <div class="container-x">
      <div class="about-grid">
        {t.blocks.map((bl, i) => (
          <Reveal delay={i * 60} class="about-item">
            <span class="label-mono">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="about-item__h">{bl.h}</h2>
            <p class="about-item__b">{bl.b}</p>
          </Reveal>
        ))}
      </div>
      <div class="about-cta">
        <BoxArrowLink href={p('/contact/')} label={t.cta} variant="accent" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-pdf { margin-top: clamp(1.5rem, 3vw, 2rem); }
  .about-blocks { background: var(--color-surface); border-top: 1px solid var(--color-line); }
  .about-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(2rem, 4vw, 3.5rem); }
  .about-item { padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .about-item__h { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.4rem, 2.4vw, 2rem); margin: 0.75rem 0 0.75rem; }
  .about-item__b { color: var(--color-mute); line-height: 1.65; max-width: 46ch; }
  .about-cta { margin-top: clamp(3rem, 5vw, 4rem); }
  @media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; } }
</style>
