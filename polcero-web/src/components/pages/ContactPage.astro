---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import JsonLd from '../JsonLd.astro';
import Reveal from '../Reveal.astro';
import { Mail, MapPin, Phone } from '@lucide/astro';
import { getUI } from '../../data/ui';
import { localizedPath, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const p = (path: string) => localizedPath(path, locale);
const t = getUI(locale).contactPage;
const crumbs = [
  { label: t.home, href: p('/') },
  { label: t.contact, href: p('/contact/') },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={`${t.contact} - POLCERO`} description={t.lead.slice(0, 154)} canonicalPath={p('/contact/')}>
  <JsonLd slot="head" schema={faqLd} />
  <PageHeader eyebrow={t.badge} title={t.title} lead={t.lead} crumbs={crumbs} />

  <section class="section">
    <div class="container-x contact">
      <Reveal class="contact__form-col">
        <form
          class="contact__form"
          method="post"
          action="/api/contact/"
          data-contact-form
          data-sending={t.sending}
          data-success={t.success}
          data-error={t.error}
          novalidate
        >
          {/* anti-spam honeypot - hidden from users, bots fill it */}
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="field">
            <label for="name">{t.name}</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder={t.namePh} required />
          </div>
          <div class="field">
            <label for="email">{t.email}</label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder={t.emailPh} required />
          </div>
          <div class="field">
            <label for="company">{t.company}</label>
            <input id="company" name="company" type="text" autocomplete="organization" placeholder={t.companyPh} />
          </div>
          <div class="field">
            <label for="subject">{t.subject}</label>
            <input id="subject" name="subject" type="text" placeholder={t.subjectPh} />
          </div>
          <div class="field">
            <label for="message">{t.message}</label>
            <textarea id="message" name="message" rows="5" placeholder={t.messagePh} required></textarea>
          </div>
          <button type="submit" class="btn-pill btn-accent" data-submit>{t.send}</button>
          <p class="contact__response">{t.response}</p>
          <p class="contact__feedback" data-feedback role="status" aria-live="polite" hidden></p>
        </form>
      </Reveal>

      <Reveal delay={80} class="contact__info">
        <h2 class="label-mono">{t.info}</h2>
        <ul>
          <li><Mail size={18} aria-hidden="true" /> <a href="mailto:biuro@polcero.com">biuro@polcero.com</a></li>
          <li><Phone size={18} aria-hidden="true" /> <a href="tel:+48535777268">+48 535 777 268</a></li>
          <li><MapPin size={18} aria-hidden="true" /> Kietrz, {t.country}</li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C20.4 8.65 22 10.6 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21H9V9Z"/></svg>
            <a href="https://www.linkedin.com/company/polskiecentrumrobotyzacji" rel="noopener" target="_blank">LinkedIn</a>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
            <a href="https://www.facebook.com/PolskieCentrumRobotyzacji" rel="noopener" target="_blank">Facebook</a>
          </li>
        </ul>
        <div class="contact__entity">
          <p class="contact__entity-name">{t.entity}</p>
          <p class="contact__entity-reg">{t.reg}</p>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="section faq">
    <div class="container-x">
      <h2 class="h3 faq__title">{t.faqTitle}</h2>
      <div class="faq__list">
        {t.faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const fb = form.querySelector<HTMLElement>('[data-feedback]');
    const original = btn?.textContent ?? '';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      if (fb) { fb.hidden = true; fb.classList.remove('is-ok', 'is-error'); }
      if (btn) { btn.disabled = true; btn.textContent = form.dataset.sending || 'Sending…'; }
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        const ok = res.ok && data.ok;
        if (fb) {
          fb.textContent = ok ? form.dataset.success! : form.dataset.error!;
          fb.classList.add(ok ? 'is-ok' : 'is-error');
          fb.hidden = false;
        }
        if (ok) form.reset();
      } catch {
        if (fb) { fb.textContent = form.dataset.error!; fb.classList.add('is-error'); fb.hidden = false; }
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = original; }
      }
    });
  }
</script>

<style>
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .contact__feedback { margin: 0; padding: 0.85rem 1rem; border-radius: 12px; font-size: 0.95rem; }
  .contact__feedback.is-ok { background: color-mix(in srgb, #34d399 14%, transparent); border: 1px solid color-mix(in srgb, #34d399 40%, transparent); color: #d1fae5; }
  .contact__feedback.is-error { background: color-mix(in srgb, var(--color-destructive, #ef4444) 14%, transparent); border: 1px solid color-mix(in srgb, #ef4444 40%, transparent); color: #fecaca; }
  .contact__form { display: flex; flex-direction: column; gap: 1.5rem; }
  .field { display: flex; flex-direction: column; gap: 0.5rem; }
  .field label { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute); }
  .field input, .field textarea {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    color: var(--color-ice);
    font-family: var(--font-sans);
    font-size: 1rem;
    transition: border-color 0.18s var(--ease-out);
  }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--color-accent); }
  .contact__form button { align-self: flex-start; margin-top: 0.5rem; }
  .contact__response { color: var(--color-mute); font-size: 0.9rem; }
  .contact__entity { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .contact__entity-name { font-weight: 500; color: var(--color-ice); }
  .contact__entity-reg { margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--color-mute); line-height: 1.6; }
  .contact :global(.contact__info) ul { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .contact :global(.contact__info) li { display: flex; align-items: center; gap: 0.75rem; color: var(--color-ice); }
  .contact :global(.contact__info) li svg { color: var(--color-accent); flex: 0 0 auto; }
  .contact :global(.contact__info) a:hover { color: var(--color-accent); }
  .faq { background: var(--color-surface); border-top: 1px solid var(--color-line); }
  .faq__title { margin-bottom: 2rem; }
  .faq__list { max-width: 60rem; }
  .faq__item { border-top: 1px solid var(--color-line); padding: 1.25rem 0; }
  .faq__item:last-child { border-bottom: 1px solid var(--color-line); }
  .faq__item summary { cursor: pointer; font-family: var(--font-display); font-size: 1.2rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq__item summary::after { content: '+'; color: var(--color-accent); font-size: 1.5rem; line-height: 1; }
  .faq__item[open] summary::after { content: '−'; }
  .faq__item p { color: var(--color-mute); line-height: 1.65; margin-top: 1rem; max-width: 60ch; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } }
</style>
