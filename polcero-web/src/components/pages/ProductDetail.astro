---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import MediaFrame from '../MediaFrame.astro';
import BoxArrowLink from '../BoxArrowLink.astro';
import JsonLd from '../JsonLd.astro';
import Reveal from '../Reveal.astro';
import { getContent } from '../../data/content';
import { getProductSpecs } from '../../data/productSpecs';
import { getProductRich } from '../../data/productRich';
import { getUI } from '../../data/ui';
import { localizedPath, type Locale } from '../../lib/i18n';

interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const c = getContent(locale);
const product = c.products.find((p) => p.slug === slug)!;
const specGroups = getProductSpecs(product, locale);
const rich = getProductRich(slug, locale);
const t = getUI(locale).productDetail;
const specNote = t.specNote;
const p = (path: string) => localizedPath(path, locale);

const related = c.products.filter((x) => x.slug !== slug && x.category === product.category).slice(0, 2);
const fallback = c.products.filter((x) => x.slug !== slug && !related.includes(x)).slice(0, 2 - related.length);
const relatedFinal = [...related, ...fallback];
const relatedIndustry = c.industries[0];

// Shared modular core - robots only (skipped for the transport drone).
const showConstruction = product.kind !== 'drone';
const isHumanoidKind = product.kind === 'humanoid' || product.kind === 'mobile-humanoid';
// Perception tile: humanoids show the sensor head; specialized robots show the tool/camera mast.
const constructionImgs = [
  '/media/core-module.webp',                                          // Core module
  '/media/chassis-lineup.webp',                                       // Swappable chassis
  '/media/core-battery.webp',                                         // Swappable batteries
  isHumanoidKind ? '/media/perception-head.webp' : '/media/perception-mast.webp', // Perception
];
const construction = {
  title: t.construction.title,
  lead: t.construction.lead,
  parts: t.construction.parts.map((part, i) => ({ ...part, img: constructionImgs[i] })),
};

const crumbs = [
  { label: t.home, href: p('/') },
  { label: t.products, href: p('/products/') },
  { label: product.name, href: p(`/products/${slug}/`) },
];

const site = Astro.site ?? new URL('https://polcero.com');
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  category: product.category,
  description: product.blurb,
  image: new URL(product.image, site).href,
  brand: { '@type': 'Brand', name: 'POLCERO' },
  manufacturer: { '@type': 'Organization', name: 'POLCERO' },
  url: new URL(p(`/products/${slug}/`), site).href,
};

const title = `${product.name} - POLCERO`;
const description = product.blurb.slice(0, 154);
---
<Layout title={title} description={description} canonicalPath={p(`/products/${slug}/`)}>
  <JsonLd slot="head" schema={productLd} />
  <PageHeader eyebrow={product.category} title={product.name} lead={product.blurb} crumbs={crumbs} />

  <section class="section">
    <div class="container-x product-detail">
      <Reveal class="product-detail__media">
        <MediaFrame src={product.image} alt={`${product.name} - POLCERO`} width={1024} height={1024} radius="media" fit="contain" />
      </Reveal>
      <Reveal delay={80} class="product-detail__body">
        {product.subtitle && <p class="product-detail__subtitle">{product.subtitle}</p>}
        <p class="label-mono">{t.specs}</p>
        <p class="lead">{product.blurb}</p>
        {product.specs && (
          <dl class="product-specs">
            {product.specs.map((s) => (
              <div class="product-specs__row">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        )}
        <p class="product-detail__note">{t.note}</p>
        {product.price && (
          <p class="product-detail__price"><span>{t.price}</span>{product.price}</p>
        )}
        <div class="product-detail__cta">
          <a class="btn-pill btn-accent" href={p('/contact/')}>{t.cta}</a>
          <BoxArrowLink href={p(`/industries/${relatedIndustry.slug}/`)} label={relatedIndustry.name} variant="dark" />
        </div>
      </Reveal>
    </div>
  </section>

  {rich.application && (
    <section class="appband">
      <img class="appband__img" src={rich.application.image} alt={rich.application.alt} width="1600" height="900" loading="lazy" decoding="async" />
      <div class="container-x appband__inner">
        <Reveal>
          <h2 class="h3 appband__title">{rich.application.title}</h2>
          <p class="lead appband__body">{rich.application.body}</p>
        </Reveal>
      </div>
    </section>
  )}

  {rich.versions && (
    <section class="section versions">
      <div class="container-x">
        <div class="versions__head">
          <h2 class="h3">{rich.versions.title}</h2>
          <p class="lead versions__lead">{rich.versions.lead}</p>
        </div>
        <div class="versions__grid">
          {rich.versions.items.map((v, i) => (
            <Reveal delay={i * 70}>
              <article class="version">
                <span class="version__tile"><img src={v.image} alt={v.alt} width="640" height="640" loading="lazy" decoding="async" /></span>
                <h3 class="version__name">{v.name}</h3>
                <p class="version__blurb">{v.blurb}</p>
                <dl class="version__specs">
                  {v.specs.map((s) => (<div><dt>{s.label}</dt><dd>{s.value}</dd></div>))}
                </dl>
              </article>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  )}

  {product.platforms && product.platforms.length > 0 && (
    <section class="section platforms">
      <div class="container-x">
        <div class="platforms__head">
          <p class="eyebrow">{t.platforms}</p>
          <p class="lead platforms__lead">{t.platformsLead}</p>
        </div>
        <div class="platforms__grid">
          {product.platforms.map((pf, i) => (
            <Reveal delay={(i % 4) * 60}>
              <article class="platform">
                <span class="platform__tile"><img src={pf.image} alt={pf.name} width="360" height="360" loading="lazy" decoding="async" /></span>
                <h3 class="platform__name">{pf.name}</h3>
                <p class="platform__blurb">{pf.blurb}</p>
                <dl class="platform__specs">
                  <div><dt>{t.drive}</dt><dd>{pf.drive}</dd></div>
                  <div><dt>{t.terrain}</dt><dd>{pf.terrain}</dd></div>
                </dl>
              </article>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  )}

  {rich.robots && (
    <section class="section robots-detail">
      <div class="container-x">
        <div class="robots-detail__head">
          <h2 class="h3">{rich.robots.title}</h2>
          <p class="lead robots-detail__lead">{rich.robots.lead}</p>
        </div>
        <div class="robots-detail__list">
          {rich.robots.items.map((r, i) => (
            <Reveal delay={(i % 2) * 60}>
              <article class="rbot">
                <span class="rbot__tile"><img src={r.image} alt={r.alt} width="560" height="560" loading="lazy" decoding="async" /></span>
                <div class="rbot__body">
                  <p class="label-mono rbot__role">{r.role}</p>
                  <h3 class="rbot__name">{r.name}</h3>
                  <p class="rbot__desc">{r.body}</p>
                  <p class="rbot__modify"><span class="label-mono">{t.modify}</span>{r.modify}</p>
                </div>
              </article>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  )}

  {rich.drone && (
    <section class="section drone-carry">
      <div class="container-x">
        <div class="drone-carry__grid">
          <Reveal class="drone-carry__media">
            {rich.drone.images.map((im) => (
              <span class="drone-carry__tile"><img src={im.src} alt={im.alt} width="720" height="720" loading="lazy" decoding="async" /></span>
            ))}
          </Reveal>
          <Reveal delay={80} class="drone-carry__body">
            <h2 class="h3">{rich.drone.title}</h2>
            <p class="lead">{rich.drone.body}</p>
            <ul class="drone-carry__points">
              {rich.drone.points.map((pt) => (<li>{pt}</li>))}
            </ul>
          </Reveal>
        </div>
      </div>
    </section>
  )}

  {product.uses && product.uses.length > 0 && (
    <section class="section uses-section">
      <div class="container-x">
        <div class="uses-head">
          <p class="eyebrow">{t.uses}</p>
          <p class="lead uses-head__lead">{t.usesLead}</p>
        </div>
        <Reveal>
          <ul class="uses-grid">
            {product.uses.map((u, i) => (
              <li class="use">
                <span class="use__num label-mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="use__text">{u}</span>
              </li>
            ))}
          </ul>
        </Reveal>
      </div>
    </section>
  )}

  {showConstruction && (
    <section class="section construction">
      <div class="container-x">
        <div class="construction__head">
          <h2 class="h3">{construction.title}</h2>
          <p class="lead construction__lead">{construction.lead}</p>
        </div>
        <div class="construction__grid">
          {construction.parts.map((part, i) => (
            <Reveal delay={i * 60}>
              <div class="construction__item">
                <span class="construction__tile"><img src={part.img} alt={part.name} width="360" height="360" loading="lazy" decoding="async" /></span>
                <span class="construction__name">{part.name}</span>
                <span class="construction__spec">{part.spec}</span>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  )}

  {rich.battery && (
    <section class="section battery">
      <div class="container-x battery__grid">
        <Reveal class="battery__media">
          <span class="battery__tile"><img src={rich.battery.image} alt={rich.battery.alt} width="720" height="720" loading="lazy" decoding="async" /></span>
        </Reveal>
        <Reveal delay={80} class="battery__body">
          <h2 class="h3">{rich.battery.title}</h2>
          <p class="lead">{rich.battery.lead}</p>
          <dl class="battery__specs">
            {rich.battery.rows.map((r) => (<div><dt>{r.label}</dt><dd>{r.value}</dd></div>))}
          </dl>
        </Reveal>
      </div>
    </section>
  )}

  {rich.swap && (
    <section class="section swap">
      <div class="container-x">
        <div class="swap__head">
          <h2 class="h3">{rich.swap.title}</h2>
          <p class="lead swap__lead">{rich.swap.lead}</p>
        </div>
        <div class="swap__grid">
          <Reveal class="swap__media">
            <span class="swap__tile"><img src={rich.swap.image} alt={rich.swap.alt} width="900" height="600" loading="lazy" decoding="async" /></span>
          </Reveal>
          <Reveal delay={80} class="swap__cols">
            <div class="swap__col">
              <h3 class="swap__col-title">{rich.swap.robot.title}</h3>
              <ol class="swap__steps">{rich.swap.robot.steps.map((s) => (<li>{s}</li>))}</ol>
            </div>
            <div class="swap__col">
              <h3 class="swap__col-title">{rich.swap.human.title}</h3>
              <ol class="swap__steps">{rich.swap.human.steps.map((s) => (<li>{s}</li>))}</ol>
            </div>
          </Reveal>
        </div>
      </div>
    </section>
  )}

  {rich.status && (
    <section class="section bstatus">
      <div class="container-x bstatus__grid">
        <Reveal class="bstatus__body">
          <h2 class="h3">{rich.status.title}</h2>
          <p class="lead">{rich.status.lead}</p>
          <dl class="bstatus__points">
            {rich.status.points.map((pt) => (<div><dt>{pt.title}</dt><dd>{pt.text}</dd></div>))}
          </dl>
        </Reveal>
        <Reveal delay={80} class="bstatus__media">
          <span class="bstatus__tile"><img src={rich.status.image} alt={rich.status.alt} width="960" height="640" loading="lazy" decoding="async" /></span>
        </Reveal>
      </div>
    </section>
  )}

  {rich.vision && (
    <section class="section vision">
      <div class="container-x">
        <div class="vision__head">
          <h2 class="h3">{rich.vision.title}</h2>
          <p class="lead vision__lead">{rich.vision.lead}</p>
        </div>
        <div class="vision__stage">
          {rich.vision.views.map((v, i) => (
            <Reveal delay={i * 60} class={`vision__view vision__view--${i}`}>
              <span class="vision__label label-mono">{v.label}</span>
              <p class="vision__text">{v.text}</p>
            </Reveal>
          ))}
          <span class="vision__img"><img src={rich.vision.image} alt={rich.vision.alt} width="900" height="600" loading="lazy" decoding="async" /></span>
        </div>
        <div class="vision__extra">
          {rich.vision.extra.map((e, i) => (
            <Reveal delay={i * 50}>
              <div class="vision__xitem">
                <h3 class="vision__xtitle">{e.title}</h3>
                <p class="vision__xtext">{e.text}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  )}

  {rich.power && (
    <section class="section power">
      <div class="container-x">
        <div class="power__head">
          <h2 class="h3">{rich.power.title}</h2>
          <p class="lead power__lead">{rich.power.lead}</p>
        </div>
        <div class="power__grid">
          {rich.power.modes.map((m, i) => (
            <Reveal delay={i * 60}>
              <div class="power__mode">
                <span class="power__num label-mono">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="power__mode-name">{m.name}</h3>
                <p class="power__mode-text">{m.text}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section pspec">
    <div class="container-x">
      <h2 class="h3 pspec__title">{t.specification}</h2>
      <div class="pspec__grid">
        {specGroups.map((g) => (
          <div class="pspec__group">
            <p class="pspec__group-title label-mono">{g.title}</p>
            <dl class="pspec__rows">
              {g.rows.map((r) => (
                <div class="pspec__row"><dt>{r.label}</dt><dd>{r.value}</dd></div>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <p class="pspec__note">{specNote}</p>
    </div>
  </section>

  <section class="section related">
    <div class="container-x">
      <div class="related__head">
        <h2 class="h3">{t.related}</h2>
        <BoxArrowLink href={p('/products/')} label={t.back} variant="dark" />
      </div>
      <div class="related__grid">
        {relatedFinal.map((r) => (
          <a class="related__card" href={p(`/products/${r.slug}/`)}>
            <span class="related__thumb"><img src={r.image} alt="" width="256" height="256" loading="lazy" /></span>
            <span>
              <span class="label-mono">{r.category}</span>
              <span class="related__name">{r.name}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-detail { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .product-detail :global(.product-detail__body) { display: flex; flex-direction: column; gap: 1.5rem; }
  .product-detail__subtitle { color: var(--color-accent); font-family: var(--font-display); font-weight: 500; font-size: clamp(1.15rem, 1.8vw, 1.45rem); }
  .product-detail__price { display: flex; align-items: baseline; gap: 0.75rem; font-family: var(--font-display); font-weight: 500; font-size: 1.35rem; color: var(--color-ice); }
  .product-detail__price span { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-mute); }
  .product-detail__note { color: var(--color-mute); line-height: 1.65; }
  .product-specs { margin: 0.5rem 0 0; display: grid; gap: 0; border-top: 1px solid var(--color-line); }
  .product-specs__row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--color-line); }
  .product-specs dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-mute); }
  .product-specs dd { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 1.15rem; color: var(--color-ice); text-align: right; }
  .product-detail__cta { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; margin-top: 0.75rem; }
  .uses-section { border-top: 1px solid var(--color-line); }
  .uses-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .uses-head .eyebrow { margin-bottom: 0.85rem; }
  .uses-head__lead { color: var(--color-mute); }
  .uses-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; }
  .use { display: flex; gap: 1rem; align-items: baseline; padding: 1.15rem 0; border-top: 1px solid var(--color-line); }
  .use__num { color: var(--color-accent); flex: 0 0 auto; }
  .use__text { color: var(--color-ice); font-size: 1.05rem; line-height: 1.5; }
  @media (min-width: 721px) { .use:nth-child(2) { border-top: 1px solid var(--color-line); } }
  @media (max-width: 720px) { .uses-grid { grid-template-columns: 1fr; } }

  .platforms { border-top: 1px solid var(--color-line); }
  .platforms__head { max-width: 46rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .platforms__head .eyebrow { margin-bottom: 0.85rem; }
  .platforms__lead { color: var(--color-mute); }
  .platforms__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  .platform { display: flex; flex-direction: column; height: 100%; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); overflow: hidden; }
  .platform__tile { display: block; aspect-ratio: 1 / 1; background: var(--color-panel); border-bottom: 1px solid var(--color-line); }
  .platform__tile img { width: 100%; height: 100%; object-fit: contain; padding: 8%; }
  .platform__name { font-family: var(--font-display); font-weight: 500; font-size: 1.15rem; color: var(--color-ice); margin: 1rem 1.1rem 0.4rem; }
  .platform__blurb { color: var(--color-mute); font-size: 0.9rem; line-height: 1.55; margin: 0 1.1rem 1rem; }
  .platform__specs { margin: auto 1.1rem 1.1rem; display: grid; gap: 0; }
  .platform__specs > div { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.5rem 0; border-top: 1px solid var(--color-line); }
  .platform__specs dt { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-mute); }
  .platform__specs dd { margin: 0; font-size: 0.82rem; color: var(--color-ice); text-align: right; }
  @media (max-width: 900px) { .platforms__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .platforms__grid { grid-template-columns: 1fr; } }

  .construction { background: var(--color-surface); border-top: 1px solid var(--color-line); }
  .construction__head { max-width: 60rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .construction__lead { margin-top: 1rem; }
  .construction__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.25rem, 2.5vw, 2rem); }
  .construction__item { display: flex; flex-direction: column; gap: 0.4rem; height: 100%; }
  .construction__name, .construction__spec { display: block; }
  .construction__tile {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    background: var(--color-panel);
    overflow: hidden;
    border: 1px solid var(--color-line);
    margin-bottom: 0.5rem;
  }
  .construction__tile img { width: 100%; height: 100%; object-fit: contain; padding: 12%; }
  .construction__name { font-family: var(--font-display); font-weight: 500; font-size: 1.1rem; color: var(--color-ice); }
  .construction__spec { font-size: 0.9rem; color: var(--color-mute); line-height: 1.5; }
  @media (max-width: 900px) { .construction__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .construction__grid { grid-template-columns: 1fr; } }

  .pspec { border-top: 1px solid var(--color-line); }
  .pspec__title { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .pspec__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  .pspec__group { border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); padding: clamp(1.25rem, 2vw, 1.75rem); }
  .pspec__group-title { color: var(--color-accent); margin-bottom: 0.75rem; }
  .pspec__rows { margin: 0; }
  .pspec__row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-top: 1px solid var(--color-line); }
  .pspec__row:first-child { border-top: 0; }
  .pspec__row dt { color: var(--color-mute); font-size: 0.92rem; }
  .pspec__row dd { margin: 0; color: var(--color-ice); font-size: 0.92rem; font-weight: 500; text-align: right; }
  .pspec__note { margin-top: 1.5rem; color: var(--color-mute); font-size: 0.82rem; line-height: 1.6; max-width: 80ch; }
  @media (max-width: 720px) { .pspec__grid { grid-template-columns: 1fr; } }

  .related { border-top: 1px solid var(--color-line); }
  .related__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; gap: 1rem; flex-wrap: wrap; }
  .related__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .related__card { display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem; border: 1px solid var(--color-line); border-radius: var(--radius-card); transition: border-color 0.2s var(--ease-out); }
  .related__card:hover { border-color: var(--color-accent); }
  .related__thumb { flex: 0 0 auto; width: 64px; height: 64px; border-radius: 14px; background: var(--color-void); overflow: hidden; border: 1px solid var(--color-line); }
  .related__thumb img { width: 100%; height: 100%; object-fit: contain; padding: 8%; }
  .related__name { display: block; font-family: var(--font-display); font-size: 1.2rem; margin-top: 0.25rem; }
  @media (max-width: 820px) {
    .product-detail { grid-template-columns: 1fr; }
    .related__grid { grid-template-columns: 1fr; }
  }

  /* APPLICATION BAND (full-width photo + copy) */
  .appband { position: relative; min-height: 64vh; display: grid; align-items: end; overflow: hidden; border-top: 1px solid var(--color-line); }
