---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 - POLCERO" description="Page not found. / Nie znaleziono strony." noindex>
  <section class="section notfound">
    <div class="container-x">
      <p class="eyebrow">404</p>
      <h1 class="h1 notfound__title">Page not found</h1>
      <p class="lead">The page you are looking for does not exist or has moved.<br />Strona, której szukasz, nie istnieje lub została przeniesiona.</p>
      <div class="notfound__cta">
        <a class="btn-pill btn-accent" href="/">Home</a>
        <a class="btn-pill btn-ghost" href="/pl/">Strona główna (PL)</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notfound { padding-top: calc(var(--header-h) + clamp(4rem, 10vw, 8rem)); min-height: 70vh; }
  .notfound__title { margin: 1.5rem 0; }
  .notfound__cta { display: flex; gap: 1rem; margin-top: 2.5rem; flex-wrap: wrap; }
</style>
