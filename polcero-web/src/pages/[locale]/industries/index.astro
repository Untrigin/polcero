---
import IndustriesIndex from '../../../components/pages/IndustriesIndex.astro';
import { secondaryLocales, type Locale } from '../../../lib/i18n';
export function getStaticPaths() {
  return secondaryLocales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
---
<IndustriesIndex locale={locale} />
