---
import Layout from '../../layouts/Layout.astro';
import Home from '../../components/Home.astro';
import JsonLd from '../../components/JsonLd.astro';

const site = Astro.site?.href ?? 'https://polcero.com/';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'POLCERO',
  legalName: 'POLCERO sp. z o.o.',
  url: site,
  logo: new URL('/icon.png', site).href,
  description: 'Autonomous humanoid robots and modular platforms for industry and agriculture.',
  email: 'biuro@polcero.com',
  telephone: '+48535777268',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kietrz',
    addressCountry: 'PL',
  },
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'KRS', value: '0001178417' },
    { '@type': 'PropertyValue', propertyID: 'NIP', value: '8971955510' },
    { '@type': 'PropertyValue', propertyID: 'REGON', value: '542000919' },
  ],
  sameAs: ['https://www.linkedin.com/company/polskiecentrumrobotyzacji', 'https://www.facebook.com/PolskieCentrumRobotyzacji'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'biuro@polcero.com',
    telephone: '+48535777268',
    areaServed: 'PL',
    availableLanguage: ['pl', 'en'],
  },
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'POLCERO',
  url: site,
  inLanguage: 'en',
};
---
<Layout
  title="POLCERO - autonomous humanoid robots"
  description="Autonomous humanoid robots and modular platforms for industry and agriculture. AI platform, 500 kg transport drone and swappable modules. You assign a goal, not a motion."
  canonicalPath="/en/"
>
  <JsonLd slot="head" schema={[organization, website]} />
  <Home locale="en" />
</Layout>
