---
import ProductDetail from '../../../components/pages/ProductDetail.astro';
import { getContent } from '../../../data/content';

export function getStaticPaths() {
  return getContent('en').products.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
---
<ProductDetail locale="en" slug={slug!} />
