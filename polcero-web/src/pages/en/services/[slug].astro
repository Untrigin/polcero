---
import BranchDetail from '../../../components/pages/BranchDetail.astro';
import { getContent } from '../../../data/content';

export function getStaticPaths() {
  return getContent('en').branches.map((b) => ({ params: { slug: b.slug } }));
}
const { slug } = Astro.params;
---
<BranchDetail locale="en" slug={slug!} />
